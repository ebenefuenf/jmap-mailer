{
	"name": "ebenefuenf/jmap-mailer",
	"description": "Symfony Mailer JMAP transport",
	"type": "symfony-mailer-bridge",
	"license": "MIT",
	"authors": [
		{
			"name": "Thomas Ernst",
			"email": "thomas.ernst@ebenefuenf.de"
		}
	],
	"homepage": "https://github.com/ebenefuenf/jmap-mailer",
	"keywords": [
		"jmap",
		"mail",
		"mailer",
		"symfony",
		"transport"
	],
	"autoload": {
		"psr-4": {
			"Ebenefuenf\\JmapMailer\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Ebenefuenf\\JmapMailer\\Tests\\": "tests/"
		}
	},
	"require": {
		"php": "^8.3",
		"symfony/mailer": "^7.4 || ^8.0",
		"symfony/http-client": "^7.4 || ^8.0"
	},
	"require-dev": {
		"carthage-software/mago": "1.50.0",
		"ernst/coverlyzer": "^0.4",
		"infection/infection": "0.35.6",
		"phpunit/phpunit": "^12.5 || ^13.4.6",
		"vimeo/psalm": "7.21.0"
	},
	"scripts": {
		"test": [
			"./vendor/bin/phpunit --testdox --no-coverage --colors=always"
		],
		"types": "./vendor/bin/psalm --no-cache",
		"lint": [
			"./vendor/bin/mago fmt --check",
			"./vendor/bin/mago lint"
		],
		"docs:format": "npx prettier@3.6.2 --write --config ./.prettierrc README.md CHANGELOG.md LICENSE.md",
		"coverage:test": "php -d xdebug.mode=coverage ./vendor/bin/phpunit --testdox --path-coverage --colors=always",
		"coverage:analyze": "./vendor/bin/coverlyzer .coverage/coverage.php",
		"coverage": [
			"composer coverage:test",
			"composer coverage:analyze"
		],
		"ci": [
			"composer lint",
			"composer coverage",
			"composer types"
		],
		"mutation": [
			"Composer\\Config::disableProcessTimeout",
			"@putenv XDEBUG_MODE=coverage",
			"./vendor/bin/infection --threads=max --log-verbosity=all"
		]
	},
	"config": {
		"allow-plugins": {
			"infection/extension-installer": true
		}
	}
}
